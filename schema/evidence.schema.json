{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.compliance-tool/schema/evidence.schema.json",
  "title": "Dropbox 证据路径索引",
  "description": "只记录路径和编号。不要把证书、报告或付费标准原文放进本文件或本仓库。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "notice", "entries"],
  "properties": {
    "schema_version": { "const": 1 },
    "notice": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["matrix_key", "dropbox_path", "type_code"],
        "properties": {
          "matrix_key": { "type": "string", "pattern": "^(EU|CA|US)-0[1-8]$" },
          "dropbox_path": { "type": "string", "pattern": "^/合规知识库/" },
          "type_code": { "enum": ["STD", "RPT", "CERT", "DOC", "LBL", "CORR"] },
          "document_number": { "type": "string" },
          "issue_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
