{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.compliance-tool/schema/market.schema.json",
  "title": "市场合规矩阵",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "market", "market_name_zh", "dimensions"],
  "properties": {
    "schema_version": { "const": 1 },
    "market": { "enum": ["EU", "CA", "US"] },
    "market_name_zh": { "type": "string", "minLength": 1 },
    "dimensions": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/dimension" }
    }
  },
  "$defs": {
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "dimension_code", "name_zh", "applies_when", "entries"],
      "properties": {
        "code": { "enum": ["01", "02", "03", "04", "05", "06", "07", "08"] },
        "dimension_code": {
          "enum": ["01CYBER", "02PACK", "03DATA", "04SAFETY", "05EMC", "06RADIO", "07BATT", "08METRO"]
        },
        "name_zh": { "type": "string", "minLength": 1 },
        "applies_when": { "$ref": "#/$defs/appliesWhen" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/entry" }
        }
      }
    },
    "appliesWhen": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["always"],
          "properties": {
            "always": { "const": true },
            "conditional_on": { "type": "string", "minLength": 1 },
            "reason_if_not": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["attribute", "equals", "reason_if_not"],
          "properties": {
            "attribute": { "type": "string", "minLength": 1 },
            "equals": { "type": ["boolean", "string", "number"] },
            "reason_if_not": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "regulation_name",
        "standard_numbers",
        "authority",
        "obligation",
        "certification_route",
        "label_requirements",
        "source_url",
        "verified_date",
        "status",
        "status_basis"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^(EU|CA|US)-0[1-8]$" },
        "regulation_name": { "type": "string", "minLength": 1 },
        "standard_numbers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "authority": { "type": "string", "minLength": 1 },
        "obligation": { "type": "string", "minLength": 1 },
        "certification_route": { "type": "string", "minLength": 1 },
        "label_requirements": { "type": "string" },
        "source_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "verified_date": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          ]
        },
        "status": { "enum": ["已核实", "待核实", "N/A"] },
        "status_basis": { "type": "string", "minLength": 1 },
        "attribute_notes": {
          "type": "array",
          "items": { "$ref": "#/$defs/attributeNote" }
        },
        "additional_sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" }
        },
        "band_limits": { "$ref": "#/$defs/bandLimits" },
        "health_canada_reply": { "$ref": "#/$defs/healthCanada" }
      }
    },
    "attributeNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "when": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": ["boolean", "string", "number"] }
        },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "title", "url"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "bandLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "columns", "values", "note"],
      "properties": {
        "heading": { "type": "string" },
        "columns": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "string" }
        },
        "values": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "string" }
        },
        "note": { "type": "string" },
        "row_label_in_plan": { "type": "string" }
      }
    },
    "healthCanada": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "letter", "conclusion", "points", "actions"],
      "properties": {
        "heading": { "type": "string" },
        "letter": { "type": "string" },
        "conclusion": { "type": "string" },
        "points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["topic", "text"],
            "properties": {
              "topic": { "type": "string" },
              "text": { "type": "string" }
            }
          }
        },
        "actions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
