{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.compliance-tool/schema/catalog.schema.json",
  "title": "模块与向导问题",
  "type": "object",
  "additionalProperties": false,
  "required": ["modules", "questions"],
  "properties": {
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "phase_markets", "modules"],
      "properties": {
        "schema_version": { "const": 1 },
        "phase_markets": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "enum": ["EU", "CA", "US"] }
        },
        "modules": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "summary"],
            "properties": {
              "id": { "enum": ["电子产品", "电池", "CRA", "FCC/ISED", "计量"] },
              "summary": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "questions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "questions"],
      "properties": {
        "schema_version": { "const": 1 },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "prompt", "type", "modules", "basis", "sources"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "prompt": { "type": "string", "minLength": 1 },
              "type": { "enum": ["text", "boolean", "enum"] },
              "placeholder": { "type": "string" },
              "modules": {
                "type": "array",
                "items": { "enum": ["电子产品", "电池", "CRA", "FCC/ISED", "计量"] }
              },
              "markets": {
                "type": "array",
                "items": { "enum": ["EU", "CA", "US"] }
              },
              "show_when": {
                "type": "object",
                "additionalProperties": { "type": ["boolean", "string"] }
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "label"],
                  "properties": {
                    "id": { "type": "string" },
                    "label": { "type": "string" }
                  }
                }
              },
              "basis": { "type": "string", "minLength": 1 },
              "sources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["label"],
                  "properties": {
                    "label": { "type": "string" },
                    "url": { "type": "string", "pattern": "^https://" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
